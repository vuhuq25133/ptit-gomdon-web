!**/.env.example

# 4. Logs & Nhật ký tiến trình
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 5. Cache trình biên dịch & Bundler
**/.vite/
**/.vite-temp/
.eslintcache
.stylelintcache

# 6. File rác hệ điều hành Windows / macOS
desktop.ini
Thumbs.db
.DS_Store
$RECYCLE.BIN/

